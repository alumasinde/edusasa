APP_NAME="EduSasa"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://edusasa.test
APP_TIMEZONE=Africa/Nairobi

# Platform administration hosts. Keep school tenant hosts separate.
PLATFORM_HOST=admin.edusasa.co.ke
PLATFORM_HOSTS=admin.edusasa.co.ke,platform.edusasa.co.ke

# Central platform database. This database contains SaaS/platform metadata only.
PLATFORM_DB_HOST=127.0.0.1
PLATFORM_DB_PORT=3306
PLATFORM_DB_DATABASE=edusasa_platform
PLATFORM_DB_USERNAME=root
PLATFORM_DB_PASSWORD=
PLATFORM_DB_CHARSET=utf8mb4

# Tenant database defaults. Individual tenant database names are resolved
# from the trusted platform registry and are never supplied by HTTP input.
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=3306
TENANT_DB_USERNAME=
TENANT_DB_PASSWORD=
TENANT_DB_CHARSET=utf8mb4

# Legacy DB_* settings remain temporarily for compatibility while the
# shared-database migration is phased out. Do not use them for tenant routing.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=edusasa
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

SESSION_NAME=edusasa_session

MAIL_DRIVER=log
MAIL_FROM_ADDRESS=no-reply@edusasa.co.ke
MAIL_FROM_NAME="EduSasa"

ASSET_VERSION=1

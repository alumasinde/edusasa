APP_NAME="EduSasa"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://edusasa.test
APP_TIMEZONE=Africa/Nairobi

# Reserved platform administration host.
PLATFORM_SUBDOMAIN=platform

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=edusasa
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

SESSION_NAME=edusasa_session

MAIL_DRIVER=log
MAIL_FROM_ADDRESS=no-reply@edusasa.co.ke
MAIL_FROM_NAME="EduSasa"

ASSET_VERSION=1

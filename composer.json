{
    "name": "albatech/edusasa",
    "description": "EduSasa — enterprise-ready multi-tenant school management platform for PHP/MySQL",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "phpoffice/phpspreadsheet": "^5.8"
    },
    "autoload": {
        "psr-4": {
            "App\\Core\\": "app/Core/",
            "App\\Components\\": "app/Components/",
            "Modules\\": "modules/"
        },
        "files": [
            "app/Core/Helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true
    }
}
